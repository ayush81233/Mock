# ============================================================
# YojanaSaathi Backend — Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in the values.
# NEVER commit your actual .env file to Git.

# ------------------------------------
# Django Core
# ------------------------------------

# REQUIRED: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames (no scheme, no port)
# Example for production: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated full origins for CORS (scheme + host + port)
# Example for public tunnel: DJANGO_CORS_ALLOWED_ORIGINS=https://your-tunnel.example.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated full origins trusted for CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------
# Twilio OTP (required for OTP login)
# ------------------------------------

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated 10-digit Indian mobile numbers allowed to receive OTP
# (Twilio trial accounts only send OTP to verified numbers)
TWILIO_ALLOWED_MOBILE=9876543210,9123456789

# OTP mode: "twilio" (live) or "console" (prints OTP to server log, for local dev)
OTP_MODE=twilio
